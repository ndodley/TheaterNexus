# Django
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
POSTGRES_DB=theater_nexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Stripe (optional unless testing checkout)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Social login (optional)
# Create a Google OAuth client (Web) and set the Client ID here.
GOOGLE_OAUTH_CLIENT_ID=

# Email (verification / transactional)
# Dev default is console output; set SMTP values below to send real mail.
PRODUCT_NAME=Theater Nexus
FRONTEND_BASE_URL=http://localhost:5173

# Set to 'django.core.mail.backends.smtp.EmailBackend' to send real emails.
DJANGO_EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=Theater Nexus <no-reply@localhost>
SUPPORT_EMAIL=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10

# SMTP troubleshooting (DEV ONLY)
# If you see SSLCertVerificationError due to AV/corporate proxy TLS interception,
# you can temporarily disable TLS verification by using the custom backend:
#   DJANGO_EMAIL_BACKEND=backend.email_backend.EmailBackend
#   EMAIL_INSECURE_TLS=1
EMAIL_INSECURE_TLS=0

# Optional: point to a CA bundle PEM to trust your intercepting proxy/root CA
EMAIL_CA_BUNDLE=

# Verification token settings
EMAIL_VERIFICATION_MAX_AGE_SECONDS=86400
EMAIL_VERIFICATION_SALT=accounts.email_verification
